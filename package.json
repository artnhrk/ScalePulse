{
  "name": "scalepulse",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "version": "1.0.0",
  "description": "HIGH_THROUGHPUT",
  "homepage": "https://github.com/pythonpioneer/ScalePulse#readme",
  "bugs": {
    "url": "https://github.com/pythonpioneer/ScalePulse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pythonpioneer/ScalePulse.git"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "ISC",
  "author": "Hritik Kumar Sinha",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "audit:check": "npx check-audit",
    "test": "vitest run",
    "test:tree": "vitest run --reporter=tree",
    "test:ci": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/client": "^7.6.0",
    "@scalar/fastify-api-reference": "^1.48.5",
    "@sinclair/typebox": "^0.34.48",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
