{
  "name": "scalepulse",
  "version": "1.0.0",
  "description": "HIGH_THROUGHPUT",
  "homepage": "https://github.com/pythonpioneer/ScalePulse#readme",
  "bugs": {
    "url": "https://github.com/pythonpioneer/ScalePulse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pythonpioneer/ScalePulse.git"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "ISC",
  "author": "Hritik Kumar Sinha",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@prisma/client": "^7.4.1",
    "fastify": "^5.7.4",
    "prisma": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}